read snippets/PPCollider.in
create Herwig::MEPP2GammaJetLoop /Herwig/MatrixElements/GammaJetLoopValidation HwMEHadron.so
insert /Herwig/MatrixElements/SubProcess:MatrixElements 0 /Herwig/MatrixElements/GammaJetLoopValidation
set /Herwig/EventHandlers/Luminosity:Energy 510*GeV
set /Herwig/Partons/HardLOPDF:PDFName NNPDF40_nlo_pch_as_01180
set /Herwig/Partons/ShowerLOPDF:PDFName NNPDF40_nlo_pch_as_01180
set /Herwig/Shower/ShowerHandler:Interactions QCD
set /Herwig/Shower/ShowerHandler:SpinCorrelations Yes
set /Herwig/Shower/ShowerHandler:MPIHandler NULL
set /Herwig/Cuts/JetKtCut:MinKT 0*GeV
set /Herwig/Cuts/PhotonKtCut:MinKT 4*GeV
set /Herwig/Cuts/Cuts:MHatMin 0*GeV
set /Herwig/Samplers/Sampler:BinSampler:InitialPoints 10000
set /Herwig/Generators/EventGenerator:PrintEvent 0
set /Herwig/Generators/EventGenerator:MaxErrors 100
set /Herwig/EventHandlers/EventHandler:Cuts:ScaleMin 2*GeV2
set /Herwig/EventHandlers/EventHandler:Cuts:X1Min 1e-5
set /Herwig/EventHandlers/EventHandler:Cuts:X2Min 1e-5
set /Herwig/Particles/c:NominalMass 1.27*GeV
set /Herwig/Particles/b:NominalMass 4.18*GeV
set /Herwig/Particles/t:NominalMass 172.69*GeV
